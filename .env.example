# ================================================================
# NUSAL — Variables de entorno para Netlify
# Dónde: Netlify → proyecto nusal-app → Project configuration →
#        Environment variables → Add a variable → Import from a .env file
# Copia desde la línea NODE_ENV hasta MEDICO_NAME, cambia los valores y pega.
# Nunca subas a GitHub un fichero .env con valores reales (este es solo un ejemplo).
# Tras cambiar cualquier variable: Deploys → Trigger deploy.
# ================================================================

NODE_ENV=production

# ─── Base de datos: Supabase ───
# Supabase → proyecto NUSAL → botón "Connect" → "Session pooler" → copia la cadena TAL CUAL
# (acaba en :5432/postgres; deja [YOUR-PASSWORD] sin cambiar).
DATABASE_URL=postgresql://postgres.TU_ID_DE_PROYECTO:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# La contraseña de la base de datos, aparte (Supabase → Project Settings → Database → Reset database password).
DB_PASSWORD=la-contraseña-de-la-base-de-datos

# ─── Seguridad (obligatorias; 32 caracteres o más, distintas entre sí) ───
# Genera cada una con un gestor de contraseñas. Guarda FIELD_ENCRYPTION_KEY y BACKUP_KEY
# y NO las cambies nunca: cifran la historia clínica y las copias de seguridad.
JWT_SECRET=frase-aleatoria-numero-uno-de-32-caracteres
FIELD_ENCRYPTION_KEY=frase-aleatoria-numero-dos-de-32-caracteres
BACKUP_KEY=frase-aleatoria-numero-tres-de-32-caracteres

# ─── Cuentas iniciales (solo se usan la PRIMERA vez; después borra las dos contraseñas) ───
# ADMIN = parte técnica + médica · MEDICO = solo parte médica (la doctora)
ADMIN_EMAIL=tu-correo@tudominio.es
ADMIN_PASSWORD=minimo-10-caracteres
MEDICO_EMAIL=correo-de-la-doctora@tudominio.es
MEDICO_PASSWORD=minimo-10-caracteres
MEDICO_NAME=Nombre con el que la ven los pacientes

# ================================================================
# OPCIONALES — añádelas solo cuando las necesites (quita la # del principio)
# ================================================================

# ─── Correo (recuperar contraseña y avisos de cita por email) ───
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# MAIL_FROM=NUSAL <no-reply@tudominio.es>

# ─── Notificaciones push (genera las claves con: npx web-push generate-vapid-keys) ───
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@tudominio.es

# ─── IA para dietas automáticas (sin ella, se montan con el banco de comidas) ───
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ─── Ajustes avanzados (normalmente no hacen falta) ───
# BACKUP_KEEP=30            copias que se guardan (mínimo 3)
# DB_SCHEMA=nusal           esquema propio en Supabase
# CORS_ORIGIN=https://otro-dominio.es   solo si usas un dominio propio además de nusal-app.netlify.app
